{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bld & d",
      "detail": "フルビルド＆デプロイ（初回・依存関係変更時）",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.vscode/deploy.sh --full ${input:project}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$maven"
    },
    {
      "label": "cmp",
      "detail": "Javaクラスのみ再コンパイル（Tomcat自動リロード）",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.vscode/deploy.sh --java ${input:project}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$maven"
    },
    {
      "label": "dpl:static",
      "detail": "HTML等の静的リソースのみコピー（Echo-Webのみ）",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.vscode/deploy.sh --static Echo-Web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "dpl:vite",
      "detail": "Viteビルド＋静的リソースコピー（Echo-Webのみ）",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.vscode/deploy.sh --vite Echo-Web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },

    // old tasks

    // ===================================================
    // Deploy Classes: クラスファイルのみ更新
    // ===================================================
    {
      "label": "compile",
      "detail": "クラスファイルのみ再コンパイルして webapps に反映します（静的リソースは対象外）",
      "type": "shell",
      "command": "mvn compile -f ${input:project}/pom.xml && cp -r ${input:project}/target/classes/* ${input:deploy-dir}/WEB-INF/classes/",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$maven"
    },
    // ===================================================
    // Deploy Static: 静的リソースのみコピー
    // ===================================================
    {
      "label": "deploy:static",
      "detail": "HTML / JS / CSS など静的リソースのみ webapps に反映します",
      "type": "shell",
      "command": "rsync -av --exclude='WEB-INF' ${workspaceFolder}/${input:project}/src/main/webapp/ ${input:deploy-dir}/",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    // ===================================================
    // Deploy Clean: webapps をクリーン
    // ===================================================
    {
      "label": "deploy:clean",
      "detail": "Tomcat の webapps をクリーンします",
      "type": "shell",
      "command": "rm -rf ${input:deploy-dir}/*",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    // ===================================================
    // Build: WAR を作成              FIXME:
    // ===================================================
    {
      "label": "build",
      "detail": "mvn clean package で WAR ファイルを生成します",
      "type": "shell",
      "command": "mvn clean package -DskipTests",
      "options": {
        "cwd": "${workspaceFolder}/${input:project}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$maven"
    },
    // ===================================================
    // Deploy: デプロイディレクトリに WAR を展開
    // ===================================================
    {
      "label": "deploy",
      "detail": "ビルド済みの WAR を展開してwebapps/ にコピーします",
      "type": "shell",
      // TOMCAT_HOME が未設定の場合は /opt/tomcat にフォールバック
      "command": "cd ${input:deploy-dir} && jar -xf ${input:project}/target/${input:container}.war",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },

    // ===================================================
    // Build & Clean Deploy
    // ===================================================
    {
      "label": "build & deploy",
      "detail": "ビルドしてそのまま Tomcat にデプロイします",
      "dependsOrder": "sequence",
      "dependsOn": ["build", "deploy:clean", "deploy"],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    // ===================================================
    // Test: テストを実行
    // ===================================================
    {
      "label": "test",
      "detail": "mvn test でテストを実行します",
      "type": "shell",
      "command": "mvn test",
      "options": {
        "cwd": "${workspaceFolder}/${input:project}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": "$maven"
    },
    // ===================================================
    // Tomcat: ログを流す
    // ===================================================
    {
      "label": "tomcat:log",
      "detail": "tomcatのログをリアルタイムで表示します",
      "type": "shell",
      "command": "docker compose logs -f ${input:container}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    // ===================================================
    // Docker: profile単位で起動
    // ===================================================
    {
      "label": "docker:up:profile",
      "detail": "指定したprofileのコンテナを起動します",
      "type": "shell",
      "command": "docker compose --profile ${input:profile} up -d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    // ===================================================
    // Docker: コンテナ単体で起動
    // ===================================================
    {
      "label": "docker:up:container",
      "detail": "指定したコンテナを単体で起動します",
      "type": "shell",
      "command": "docker compose up -d ${input:container}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    // ===================================================
    // Docker: profile単位で停止
    // ===================================================
    {
      "label": "docker:down:profile",
      "detail": "指定したprofileのコンテナを停止します",
      "type": "shell",
      "command": "docker compose --profile ${input:profile} down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    // ===================================================
    // Docker: コンテナ単体で停止
    // ===================================================
    {
      "label": "docker:down:container",
      "detail": "指定したコンテナを単体で停止します",
      "type": "shell",
      "command": "docker compose stop ${input:container}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "profile",
      "type": "pickString",
      "description": "起動するprofileを選択してください",
      "options": ["echo", "message"]
    },
    {
      "id": "container",
      "type": "pickString",
      "description": "起動するコンテナを選択してください",
      "options": ["echo-restapi", "echo-web", "message-web"]
    },
    {
      "id": "project",
      "type": "pickString",
      "description": "プロジェクトを選択してください",
      "options": ["Echo-RestAPI", "Echo-Web", "Message-Web"]
    },
    {
      "id": "deploy-dir",
      "type": "pickString",
      "description": "デプロイディレクトリを選択してください",
      "options": [
        { "label": "Echo-RestAPI", "value": "/deploy/echo/rest-api" },
        { "label": "Echo-Web", "value": "/deploy/echo/web" },
        { "label": "Message-Web", "value": "/deploy/message/web" }
      ]
    }
  ]
}
